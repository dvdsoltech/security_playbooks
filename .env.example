# Generic Foundry cloud model config
FOUNDRY_MODEL=
FOUNDRY_ENDPOINT=
FOUNDRY_API_KEY=
FOUNDRY_API_VERSION=2024-02-01

# Self-hosted vLLM
VLLM_ENDPOINT=
VLLM_MODEL=

# Splunk MCP
SPLUNK_MCP_ENDPOINT=
SPLUNK_MCP_TOKEN=
SPLUNK_MCP_SERVER_NAME=splunk-mcp-server

# Splunk API
SPLUNK_API_BASE_URL=https://your-splunk-host:8089/servicesNS/search/json
